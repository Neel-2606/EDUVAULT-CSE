# Server Port
PORT=3000

# Express Session Secret
SESSION_SECRET=cse-resourcehub-msu-secret

# Faculty Registration Secret Code
FACULTY_SECRET_CODE=CSE-MSU-2026

# Supabase Configuration
# 1. Sign up on https://supabase.com and create a new project
# 2. In Supabase Dashboard -> Project Settings -> API:
#    - Copy "Project URL" into SUPABASE_URL
#    - Copy "anon public" or "service_role" key into SUPABASE_KEY
SUPABASE_URL=
SUPABASE_KEY=

# Set to true to enable Supabase database
USE_SUPABASE=true
